{
  "name": "vlsi-cad",
  "compatibility_date": "2026-08-15",
  "keep_vars": true,
  "secrets": {
    "required": ["SMTP_PASSWORD"]
  },
  "main": "feedback-worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VISITOR_COUNTER",
        "class_name": "VisitorCounter"
      }
    ]
  },
  "exports": {
    "VisitorCounter": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
