{
  "name": "vlsi-cad",
  "compatibility_date": "2026-08-15",
  "main": "feedback-worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VISITOR_COUNTER",
        "class_name": "VisitorCounter"
      }
    ]
  },
  "exports": {
    "VisitorCounter": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "send_email": [
    {
      "name": "FEEDBACK_EMAIL",
      "destination_address": "info@vlsi-cad.com",
      "allowed_sender_addresses": ["feedback@vlsi-cad.com"]
    }
  ]
}
